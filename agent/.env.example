# Coaches' language model (OpenAI-compatible chat completions); the gateway runs on the same server as the model.
# Muse Glimmer, Meta's open-weights model, on our own GPU (default):
LLM_URL=http://127.0.0.1:11435/v1
LLM_MODEL=muse-glimmer
# Or Muse Spark on the Meta Model API (keep this file private):
# LLM_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3
# MODEL_API_KEY=
# Facebook Messenger: a Facebook Page and a Meta app with the Messenger product. Point the app's webhook at
# https://<your tunnel>/webhook/messenger with the verify token below, and subscribe the Page to "messages" and
# "messaging_postbacks". WEBHOOK_PORT serves the webhook alone on 127.0.0.1, for the tunnel to point at, e.g.
#   cloudflared tunnel --url http://127.0.0.1:8791
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_NAME=
WEBHOOK_PORT=8791
# Google Maps (Places API, text search): ratings for courts near you. A Maps demo key works (about 100 calls a day,
# no billing); GOOGLE_DAILY_LIMIT caps the calls a day (default 90).
GOOGLE_MAPS_API_KEY=
GOOGLE_DAILY_LIMIT=90
# Gateway port and the web app origins allowed to call it
PORT=8790
ALLOW_ORIGINS=http://127.0.0.1:5191,http://localhost:5191

# Highlight reels from the player's own video (video/pose/reel.py: DETR, Sapiens2, SAM 2.1 on the GPU)
REEL_PYTHON=/path/to/python-with-torch-and-transformers
REEL_SCRIPT=/path/to/video/pose/reel.py
REEL_GPU=0
REEL_HF_CACHE=
REEL_MAX_MB=300
